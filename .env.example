# Copy this file to .env and fill in what you need. .env is gitignored; this template is not,
# so never put a real key here.
#
# Only GEMINI_API_KEY is required for the tutor to answer. Everything else adds a capability
# (speech, web search, publishing courses) or points a role at another provider.

# ── Required: the models that answer, guard and remember ─────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── One model per role, each chosen by measuring that role (docs/models.md) ──
# Provider is one of: gemini, nebius, nvidia. Change a pair to move a role.
# Answers the pupil. Must support native tool calls (web search, notebook).
# APU_TUTOR_PROVIDER=gemini
# APU_TUTOR_MODEL=gemini-3.8-flash
# The topical guard. Must match apu/guardrails/config/config.yml, which NeMo reads directly.
# APU_GUARD_PROVIDER=gemini
# APU_GUARD_MODEL=gemini-3.5-flash-lite
# Extracts what to remember from each exchange, and writes the notebook's key points.
# APU_EXTRACTION_PROVIDER=gemini
# APU_EXTRACTION_MODEL=gemini-3.5-flash-lite
# Classifies a search query before it is sent. Deliberately not the guard's model.
# APU_QUERY_GATE_PROVIDER=gemini
# APU_QUERY_GATE_MODEL=gemini-3.1-flash-lite

# ── Speech, for the voice modes ──────────────────────────────────────────────
# Without it the interface still runs in text and braille, and a spoken answer falls back to
# the browser's own voice. https://elevenlabs.io/
ELEVENLABS_API_KEY=
# A voice from your own account: library voices need a paid plan.
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# APU_TTS_PROVIDER=elevenlabs
# APU_TTS_MODEL=eleven_v3
# APU_STT_PROVIDER=elevenlabs
# APU_STT_MODEL=scribe_v2
# If either is set to gemini instead:
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Kore
# GEMINI_TRANSCRIBE_MODEL=gemini-3.8-flash

# ── Web search ───────────────────────────────────────────────────────────────
# https://tavily.com/ . Without it the tutor answers from the course and its own knowledge.
TAVILY_API_KEY=

# ── Other providers, only if a role above points at them ─────────────────────
# NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NVIDIA_API_KEY=

# ── Local embedder (retrieval, runs on the device) ───────────────────────────
# Must be the full fastembed id: the bare "paraphrase-multilingual-MiniLM-L12-v2" is rejected.
# LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# LOCAL_EMBEDDING_DIM=384
# Where the ONNX files live. Populated once by scripts/fetch_embedding_model.py; the embedder
# never downloads at runtime.
# LOCAL_EMBEDDING_CACHE_DIR=./models

# ── Per-device state and memory ──────────────────────────────────────────────
# DLL JSON (L2), LanceDB (L3), escalations, notebooks, embedding stamp.
# APU_DATA_DIR=./data
# Cap on non-fixed DLL blocks. Past it, the least recently used is paged out to L3.
# APU_MAX_DYNAMIC_BLOCKS=5
# Not wired yet: the 12-block cap from the reference APU, see docs/decisions.md.
# APU_MAX_ACTIVE_BLOCKS=12

# ── Cloud course registry (Google Cloud Storage) ─────────────────────────────
# Device: registry to download courses from. The bucket is read from this URL.
# REGISTRY_MANIFEST_URL=https://storage.googleapis.com/akili-registry/manifest.json
# Pipeline: bucket that `batch_pipeline.py --upload` publishes to.
# GCS_BUCKET_NAME=akili-registry
# Both: service-account JSON. Leave unset to use Application Default Credentials
# (gcloud auth application-default login). Downloading needs one or the other.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Registries loaded at startup (demo data in registries/) ──────────────────
# APU_CLASS_POLICIES_PATH=registries/class_policies.json
# APU_TEACHER_ASSIGNMENTS_PATH=registries/teacher_assignments.json
# Recompute a class's escalation clusters after this many new events.
# APU_ESCALATION_CLUSTER_TRIGGER_COUNT=5

# ── Welfare ──────────────────────────────────────────────────────────────────
# Appended to the reply a pupil gets when they disclose distress: who to go to, and the
# helpline where the school is. Empty by default, because a wrong number is worse than none.
# APU_WELFARE_CONTACT_TEXT=

# ── Limits, all with working defaults ────────────────────────────────────────
# Web search results per query.
# TAVILY_MAX_RESULTS=5
# Longest prompt the cloud registry may install per key, since it supplies instructions.
# APU_REGISTRY_PROMPT_MAX_CHARS=8000
# The notebook: entries per pupil, and what one revision sheet may send to the model.
# APU_NOTEBOOK_MAX_ENTRIES=200
# APU_NOTEBOOK_MAX_SHEET_ENTRIES=25
# APU_NOTEBOOK_MAX_SHEET_CHARS=20000
# Speech: the recording accepted, the answer read out, and the check that catches an answer
# the model stopped reading early (measured at roughly 15 characters per second of audio).
# APU_VOICE_MAX_RECORDING_BYTES=8388608
# APU_VOICE_MAX_SPOKEN_CHARS=4000
# APU_VOICE_CHARS_PER_SECOND=15
# APU_VOICE_MIN_AUDIO_RATIO=0.6
# Demo pupils shown in the identity selector.
# APU_DEMO_STUDENTS_PATH=registries/demo_students.json

# ── Braille ──────────────────────────────────────────────────────────────────
# Needs the liblouis C library (brew install liblouis / apt install liblouis20).
# Only set this if the library is somewhere non-standard.
# LIBLOUIS_PATH=

# ── Identity in the interfaces: A STUB, there is no login ────────────────────
# APU_STUDENT_ID=eleve-aya
# APU_CLASS_ID=lycee-cocody:3eA
