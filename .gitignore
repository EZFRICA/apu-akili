# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# ── Tool caches ──────────────────────────────────────────────────────────────
# pytest and ruff each drop a .gitignore of their own inside these, so they are
# already ignored on this machine; named here so a fresh clone behaves the same.
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Secrets ──────────────────────────────────────────────────────────────────
# .env holds the provider keys. .env.example is the documented template and IS tracked.
.env
.env.*
!.env.example

# ── Per-device state, not source ─────────────────────────────────────────────
# The DLL JSON (L2), the LanceDB store (L3), the embedding stamp, the escalation
# and notebook databases, and the runtime log. A fresh clone must not inherit
# another machine's memory, and these hold student data.
data/
*.log
# SQLite in WAL mode writes these beside its database, and the DLL write leaves a
# lock and a temporary file behind if a process is killed mid-write.
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.tmp
metadata_links.json.lock

# ONNX embedding model cache (~240MB), populated by scripts/fetch_embedding_model.py.
models/

# Build output of the cloud pipeline. Regenerated from cloud_registry/courses/ by
# batch_pipeline.py and distributed through the bucket, not git.
cloud_registry/registry/

# ── Local one-offs ───────────────────────────────────────────────────────────
# Generated commit scripts: meant to be run once and deleted, never committed.
commit-*.sh
commit_changes.sh

# ── Chainlit local uploads ───────────────────────────────────────────────────
.files/

# ── Not shipped: the measurement and red team harnesses ──────────────────────
# Tools used to choose models, measure the pipeline and attack the guard. They need several
# provider keys, cost money to run, and are of no use to someone installing the tutor. Their
# findings are in docs/; the harnesses stay on the machine that ran them.
scripts/benchmark.py
scripts/eval_models.py
scripts/redteam_guard.py
scripts/redteam_social.py
scripts/list_gemini_models.py
scripts/smoke_test_tool_calling.py
benchmarks/

# ── Editors and OS ───────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/

# ── Experimental Live Runners ────────────────────────────────────────────────
apu/ui/live/runner_gemini_live.py

